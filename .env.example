# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Stripe secret key (test or live)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Price IDs from Stripe Dashboard → Products
REGISTRATION_PRICE_ID=price_YOUR_REGISTRATION_PRICE_ID
TUITION_FIRST_PRICE_ID=price_YOUR_FIRST_CHILD_PRICE_ID
TUITION_SECOND_PRICE_ID=price_YOUR_SECOND_CHILD_PRICE_ID
TUITION_THIRDPLUS_PRICE_ID=price_YOUR_THIRD_PLUS_PRICE_ID

# Redirects after Checkout
SUCCESS_URL=https://your-domain.com/success?session_id={CHECKOUT_SESSION_ID}
CANCEL_URL=https://your-domain.com/cancel

# After you add Webhook in Stripe, paste the signing secret here
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Port (optional - defaults to 8788)
# PORT=8788
